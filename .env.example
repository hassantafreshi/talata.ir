APP_NAME="زرلیو"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,errors_db
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=talata
DB_USERNAME=talata
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Must be true in production (HTTPS); false only for local http://localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
TALATA_TIMEZONE=Asia/Tehran
# kavenegar in production; log writes messages to storage/logs (development only)
TALATA_SMS_DRIVER=log
TALATA_QUOTE_DRIVER=demo
# brsapi.ir gold/currency feed (TALATA_QUOTE_DRIVER=brsapi); the key goes only in the server's .env
BRSAPI_KEY=
BRSAPI_URL=https://api.brsapi.ir/Market/Gold_Currency.php
# Payment gateway (PSP): zarinpal in production; mock only for local/demo (refused in production).
# Customer share links (/i/…) expire after N days; empty = never. Verification links (/v/…) never expire.
TALATA_SHARE_TTL_DAYS=
# Support phone shown to merchants (e.g. when a shop name needs staff approval); empty = not shown
TALATA_SUPPORT_PHONE=

TALATA_PAYMENT_DRIVER=mock
# ZarinPal (https://www.zarinpal.com): 36-character merchant id from the ZarinPal panel. Keep secret.
TALATA_ZARINPAL_MERCHANT_ID=
# true = sandbox.zarinpal.com (test payments, no real money)
TALATA_ZARINPAL_SANDBOX=false
TALATA_ZARINPAL_CONNECT_TIMEOUT=5
TALATA_ZARINPAL_TIMEOUT=15
# Send the payer's mobile to ZarinPal so it can offer saved cards (off = data minimisation)
TALATA_ZARINPAL_SEND_MOBILE=false
TALATA_PUBLIC_URL=http://localhost:8000
TALATA_OTP_DAILY_BUDGET=2000
TALATA_POW_BITS=18
TALATA_ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false
TALATA_OTP_EXISTING_DAILY_BUDGET=3000
# Admin console (/admin): staff must add a passkey before using anything but the dashboard; sensitive actions need
# a sign-in within TALATA_ADMIN_REAUTH_MINUTES. Optional comma list of allowed IPs hides the console elsewhere.
TALATA_ADMIN_REQUIRE_PASSKEY=true
TALATA_ADMIN_REAUTH_MINUTES=15
TALATA_ADMIN_IDLE_MINUTES=30
TALATA_ADMIN_ALLOWED_IPS=
# Operations facts for the admin «سلامت سیستم» page (set by deploy / backup scripts).
TALATA_RELEASE=dev
TALATA_BACKUP_HEARTBEAT_FILE=
TALATA_RESTORE_DRILL_FILE=
# Kavenegar (TALATA_SMS_DRIVER=kavenegar). Create a Verify Lookup template containing %token for login codes.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=
# Separate Verify Lookup template for the login-number change code (never the login template); empty = sms/send.
KAVENEGAR_OTP_TEMPLATE_MOBILE_CHANGE=
KAVENEGAR_TIMEOUT=10
